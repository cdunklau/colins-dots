# Use a different file for custom bits so we can easily
# get the distribution's latest from /etc/skel/.bashrc.
#
# Source this file in .bashrc proper to enable.

# Prompt hack (see make_prompt.py in the colins-dots repo)
_git_info_line() {
    BRANCH_NAME=$(
        git branch --list 2> /dev/null |
            sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'
    )
    if [ -n "$BRANCH_NAME" ]; then
        echo -e "\\ngit: branch=\033[01;31m$BRANCH_NAME\033[00m"
    fi
};

_maybe_set_default_terminal_title() {
    if [ "${PREVENT_TERMWINDOWTITLE_DEFAULT_OVERWRITE}" != "1" ]; then
        echo -ne "\001\033]0;${USER}@${HOSTNAME}: ${PWD/~/\~}\007\002"
    fi
};

export PS1="\$(_maybe_set_default_terminal_title)\[\033[01;32m\]\u\[\033[00m\]@\[\033[01;32m\]\h\[\033[00m\] \t \[\033[01;34m\]\w\[\033[00m\]\$(_git_info_line)\n--> \\$ \[\033[00m\]"

disable_terminal_title_overwrite() {
    export PREVENT_TERMWINDOWTITLE_DEFAULT_OVERWRITE=1;
}
enable_terminal_title_overwrite() {
    export PREVENT_TERMWINDOWTITLE_DEFAULT_OVERWRITE="";
}

# Editor
export EDITOR=vim


# pyenv setup
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - bash)"

# Haskell stuff
HASKELL_INIT="$HOME/.ghcup/env"
if [ -f "$HASKELL_INIT" ]; then
    source ${HASKELL_INIT}
fi

# Rust stuff
RUST_INIT="$HOME/.cargo/env"
if [ -f "$RUST_INIT" ]; then
    source ${RUST_INIT}
fi
